# CodeSheriff — environment variable reference
#
# Copy to `.env` and fill in real values:  `cp .env.example .env`
#
# Required vars have no default and the app throws at startup if missing.
# Optional vars show their default value in the comment.
#
# Layout note: the web package reads `.env` from the repo root
# (`packages/web/.env` is a symlink to `../../.env`). The CLI uses its own
# `CODESHERIFF_SERVER_URL`/`CODESHERIFF_API_KEY` from the shell environment.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma. Required.
DATABASE_URL="postgresql://user:password@localhost:5432/codesheriff"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Secret used to sign session tokens. Required, MIN 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical origin for the auth server (e.g. http://localhost:3000 in dev).
BETTER_AUTH_URL="http://localhost:3000"

# ─── GitHub OAuth (user login) ───────────────────────────────────────────────
# OAuth app credentials from https://github.com/settings/developers. Required.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── GitHub App (repo access / webhooks) ─────────────────────────────────────
# GitHub App used for repo connections, PR comments, and webhook delivery.
GITHUB_APP_ID=""
# PEM contents of the GitHub App private key (multiline, `\n`-escaped).
GITHUB_APP_PRIVATE_KEY=""
# Secret used to verify incoming GitHub webhook signatures. Required.
GITHUB_WEBHOOK_SECRET=""

# ─── App URLs ────────────────────────────────────────────────────────────────
# Public origin of the web app. Used for review URLs, emails, redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL for client-side links (usually same as NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# ─── Vector DB (Pinecone) ────────────────────────────────────────────────────
# Pinecone API key. Required — lib/pinecone.ts throws at module load if missing.
PINECONE_DB_API_KEY=""

# ─── AI providers ────────────────────────────────────────────────────────────
# OpenCode Zen API key (primary model provider). If unset, falls back to Gemini.
OPENCODE_API_KEY=""
# OpenCode Zen model id. Default: mimo-v2.5-free
OPENCODE_MODEL="mimo-v2.5-free"
# Gemini API key used by the @ai-sdk/google fallback (gemini-2.5-flash).
GOOGLE_GENERATIVE_AI_API_KEY=""

# ─── Billing (Polar) ─────────────────────────────────────────────────────────
# Polar server-side access token (secret, server-only).
POLAR_ACCESS_TOKEN=""
# Polar environment: "production" or "sandbox" (default sandbox).
POLAR_ENV="sandbox"
# Polar product id used for per-seat organization billing.
POLAR_ORG_PRODUCT_ID=""
# Redirect target after a successful checkout. Default /dashboard/subscriptions.
POLAR_SUCCESS_URL="/dashboard/subscriptions?success=true"
# Secret used to verify Polar webhook payloads. Required.
POLAR_WEBHOOK_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Resend API key for transactional email (notifications, invites, usage warnings).
RESEND_API_KEY=""

# ─── Sandbox verification (E2B) ──────────────────────────────────────────────
# Sandbox mode: "sandbox" (E2B) or "exec" (local subprocess fallback).
SANDBOX_MODE="sandbox"
# E2B API key. Required when SANDBOX_MODE="sandbox".
E2B_API_KEY=""
# Per-verification timeout in ms. Default: 120000 (max 120s).
SANDBOX_TIMEOUT_MS="120000"
# Max memory budget for the sandbox in MB. Default: 512.
SANDBOX_MAX_MEMORY_MB="512"

# ─── Indexing (Spec 0002) ────────────────────────────────────────────────────
# Set to "false" to disable incremental indexing on push webhooks.
INCREMENTAL_INDEX_ENABLED="true"
# Comma-separated branch globs allowed to trigger index-on-push. Default: main.
INDEX_PUSH_BRANCHES="main"
# Changed-file threshold above which a full reindex is forced. Default: 200.
INDEX_FULL_REINDEX_THRESHOLD="200"

# ─── Notification webhook delivery (Slack/Discord) ───────────────────────────
# Master switch for org webhook delivery (Slack/Discord).
WEBHOOK_DELIVERY_ENABLED="true"
# Per-delivery timeout in ms. Default: 5000.
WEBHOOK_DELIVERY_TIMEOUT_MS="5000"

# ─── CLI / API access ────────────────────────────────────────────────────────
# Shared secret accepted by /api/reviews/trigger for CLI-initiated reviews.
CODESHERIFF_API_KEY=""
# Base URL the CLI talks to (defaults to the hosted app; set for local dev).
CODESHERIFF_SERVER_URL="http://localhost:3000"

# ─── Tests ───────────────────────────────────────────────────────────────────
# Set to "true" to run networked integration tests (hermetic by default).
RUN_INTEGRATION_TESTS="false"
